PORT=8000

# Connection string for PostgreSQL
# For host PostgreSQL connected from Docker: postgresql://user:password@host.docker.internal:5432/ai_typer
# For local host without Docker: postgresql://user:password@localhost:5432/ai_typer
DATABASE_URL="postgresql://postgres:2001219@host.docker.internal:5432/ai_typer"

# DeepSeek configurations
DEEPSEEK_MODEL_NAME=deepseek-v4-flash
DEEPSEEK_API_KEY=your_deepseek_api_key

# Supabase Auth configurations
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
